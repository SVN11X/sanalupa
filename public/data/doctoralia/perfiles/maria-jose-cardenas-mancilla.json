os del habla y de la comunicación","Trastorno del estado de ánimo","Trastornos en la infancia","Trastornos Psicosomáticos","Problemas con los hijos","Malas conductas con los hijos","Depresión","Trastornos adaptativos","Trastornos de ansiedad","Trastorno por déficit de atención con hiperactividad (TDAH)","Ansiedad","Trastorno de la conducta alimentaria","Trastornos del sueño","Déficit Atencional","Adicciones","Trastorno del espectro autista (TEA)","Crisis de pánico","Trastorno obsesivo compulsivo (TOC)","Trastorno afectivo bipolar"],"languages":["Español"],"education":["Psicóloga, Universidad San Sebastián"],"experience":["Consulta particular"],"publications":[],"awards":[],"certificates":["https://pixel-p1.s3.sa-east-1.amazonaws.com/doctor/certificate/7dc0151c/7dc0151c-50f7-4afa-a074-193f26078981_large.jpg"],"social":[{"name":"Instagram","url":"https://www.instagram.com/ps.mariajosec"}],"badges":[],"other":[{"heading":"Enfoque terapéutico","items":["Psicoanálisis","Psicoterapia cognitivo conductual"]}],"services":[{"name":"Consulta online","price":29998,"priceText":"$29.998 - $30.000","from":false},{"name":"Primera visita Psicología","price":30000,"priceText":"$30.000","from":false},{"name":"Psicoterapia en adolescentes y adultos","price":30000,"priceText":"$30.000","from":false},{"name":"Terapia para depresión","price":30000,"priceText":"$30.000","from":false},{"name":"Terapia para ansiedad","price":30000,"priceText":"$30.000","from":false},{"name":"Terapia para adolescentes","price":30000,"priceText":"$30.000","from":false},{"name":"Terapia individual","price":30000,"priceText":"$30.000","from":false},{"name":"Terapia de duelo","price":30000,"priceText":"$30.000","from":false},{"name":"Salud mental","price":30000,"priceText":"$30.000","from":false},{"name":"Psicoterapia infantil","price":30000,"priceText":"$30.000","from":false},{"name":"Psicodiagnóstico infantil","price":30000,"priceText":"$30.000","from":false},{"name":"Visitas sucesivas Psicología","price":3000