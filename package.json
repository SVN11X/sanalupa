{
  "name": "salud-cerca-santiago",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "validate": "node --import tsx scripts/validate.ts",
    "update:data": "node --import tsx scripts/update.ts",
    "report": "node --import tsx scripts/report.ts",
    "package": "node scripts/package.mjs",
    "scrape:ratings": "node --import tsx scripts/ratings-run.ts"
  },
  "dependencies": {
    "fuse.js": "7.5.0",
    "leaflet": "1.9.4",
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.55.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cheerio": "1.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "8.3.3"
  }
}
